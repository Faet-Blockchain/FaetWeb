modules = ["nodejs-20", "web"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[workflows]

[[workflows.workflow]]
name = "Type Check"
author = 33651733
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"
